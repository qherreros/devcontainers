{
  "name": "Python 3.10 CUDA Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "ubuntu",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish"
      }
    }
  },
  "updateRemoteUserUID": true,
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.cache/huggingface",
  "mounts": [
    "source=${localEnv:HOME}/.local/share/fish,target=/home/ubuntu/.local/share/fish,type=bind",
    "source=${localEnv:HOME}/.ssh,target=/home/ubuntu/.ssh,type=bind,readonly",
    "source=${localEnv:HOME}/.gitconfig,target=/home/ubuntu/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.cache/huggingface,target=/home/ubuntu/.cache/huggingface,type=bind,readonly",
    "source=${localEnv:HOME}/.vibe,target=/home/ubuntu/.vibe,type=bind"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace"
}
